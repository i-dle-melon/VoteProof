{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voteproof",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-07",
  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "r2_buckets": [
    {
      "binding": "PROOFS_BUCKET",
      "bucket_name": "voteproof-proofs"
    }
  ]
}
