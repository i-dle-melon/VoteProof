{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voteproof",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-07",
  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voteproof-cases",
      "database_id": "9e2b885d-66e2-4e4d-b768-4bded261296a",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PROOFS_BUCKET",
      "bucket_name": "voteproof-proofs"
    }
  ]
}
