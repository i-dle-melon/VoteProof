{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voteproof",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-07",
  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voteproof-cases",
      // PLACEHOLDER: replace only after the real D1 database is created.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PROOFS_BUCKET",
      "bucket_name": "voteproof-proofs"
    }
  ]
}
